# Шаблон окружения трендвотчера. Скопировать в .env и заполнить.
# .env в репозиторий не попадает, этот файл — попадает: держать здесь только имена и примеры,
# никаких настоящих значений.

# --- Supabase ------------------------------------------------------------
# Адрес проекта и ключ service_role: Supabase → Project Settings → API.
# Нужен именно service_role — на таблицах включён RLS без политик, anon-ключ ничего не увидит.
# Ключ даёт полный доступ к базе: только в .env, никуда не копировать.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- hh.ru ---------------------------------------------------------------
# Токен приложения. Получается ВРУЧНУЮ, один раз, и живёт бессрочно:
#   POST https://api.hh.ru/token, grant_type=client_credentials
# Повторный запрос отзывает прежний токен, поэтому парсер его только читает.
# Порядок получения — BACKLOG.md, раздел 1.
HH_APP_TOKEN=

# Выдаются при создании приложения на https://dev.hh.ru/admin
# Нужны только для получения токена, в самих запросах не участвуют.
HH_CLIENT_ID=
HH_CLIENT_SECRET=

# Обязательный заголовок всех запросов к api.hh.ru.
# Формат: Название/версия (контактная почта)
HH_USER_AGENT=trendwatcher/1.0 (you@example.com)

# --- Telegram ------------------------------------------------------------
# Куда уходит сводка. Канал ещё не выбран — открытый вопрос 3 в BACKLOG.md:
# личные сообщения, свой чат или канал. До решения оставить пустым.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Парсер --------------------------------------------------------------
# Состояние между запусками и список источников — в базе Supabase (SPEC.md, раздел 2),
# локальных файлов нет. Немой первый прогон включается сам, для каждого источника
# отдельно (поле sources.baseline_done_at), — флаг для него не нужен.

# Сухой прогон: собрать сводку, но никуда не отправлять. Для будущей отправки сводки.
DRY_RUN=true

LOG_LEVEL=INFO
